<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\build\sdk-paths.props" />

  <PropertyGroup>
    <!-- 实测：ZWCAD SDK 2025/2026 托管程序集 TFM = .NETFramework,Version=4.7（非 net8） -->
    <TargetFramework>net47</TargetFramework>
    <AssemblyName>CadWebView.ZWCAD.Fx</AssemblyName>
    <RootNamespace>CadWebView</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);ZWCAD;FX</DefineConstants>
    <!-- 覆盖 ZWCAD 2025–2026（2027 SDK 暂无） -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZwManaged">
      <HintPath>$(ZWCAD_2025)\ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZWCAD_2025)\ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PaletteSet 继承链涉及 WPF 类型 -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Host.Shared\**\*.cs" Link="Host.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\Core\CadWebView.Core.csproj" />
  </ItemGroup>

</Project>