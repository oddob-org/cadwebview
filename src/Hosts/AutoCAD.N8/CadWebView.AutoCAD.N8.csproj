<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\build\sdk-paths.props" />

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>CadWebView.AutoCAD.N8</AssemblyName>
    <RootNamespace>CadWebView</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);ACAD;N8</DefineConstants>
    <!-- 覆盖 AutoCAD 2025–2026 -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(ARX_2025)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(ARX_2025)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(ARX_2025)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Host.Shared\**\*.cs" Link="Host.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\Core\CadWebView.Core.csproj" />
  </ItemGroup>

</Project>