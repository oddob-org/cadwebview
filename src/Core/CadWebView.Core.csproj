<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows;net10.0-windows</TargetFrameworks>
    <AssemblyName>CadWebView.Core</AssemblyName>
    <RootNamespace>CadWebView</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <!-- WebView2 的托管/原生 DLL 必须随交付目录一起分发 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 本工程不引用任何 CAD 程序集 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'net462'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chromium 内核。Fx 家族最低只能到 net462：WebView2 托管包不支持 net45。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- WebView2 包会为 .NET 5+ 目标自动引入 WPF 程序集；本工程只用 WinForms，
       该引用会与 WindowsBase 产生版本冲突警告（MSB3277），故在解析引用前移除。 -->
  <Target Name="CadWebViewRemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>